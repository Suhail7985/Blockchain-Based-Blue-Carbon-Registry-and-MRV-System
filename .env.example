# ==========================================
# Blue Carbon Registry - Environment Variables
# ==========================================
# Copy this file to .env and fill in the values

# MongoDB Cluster Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.rcpg0eg.mongodb.net/blue_carbon_registry?retryWrites=true&w=majority

# Security (Generate a strong random string)
JWT_SECRET=your_secure_jwt_secret_here
JWT_EXPIRE=7d

# Email Transporter (Nodemailer)
EMAIL_HOST=smtp.gmail.com   
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=noreply@domain.com

# Cloudinary Integration
USE_CLOUDINARY=true
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Polygon Blockchain configuration
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
AMOY_PRIVATE_KEY=your_private_key
NCCR_WALLET_PRIVATE_KEY=your_private_key
CARBON_CREDIT_TOKEN_ADDRESS=your_contract_address
PLANTATION_REGISTRY_ADDRESS=your_contract_address
