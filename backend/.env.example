# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/blue_carbon_db

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@bluecarbon.gov.in

# Frontend URL
FRONTEND_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRE=1h

# Blockchain - Polygon Amoy Testnet (NCCR backend wallet)
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
NCCR_WALLET_PRIVATE_KEY=your_deployer_private_key_here
PLANTATION_REGISTRY_ADDRESS=0x...
CARBON_CREDIT_TOKEN_ADDRESS=0x...
